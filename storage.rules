rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Bottle photos, shared with the catalogue.
    match /wines/{wineId}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isImage();
    }

    // Avatars and "moment" photos, owned by one user.
    match /users/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && isImage();
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
