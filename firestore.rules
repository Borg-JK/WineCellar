rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Public-to-members profile: name, username, avatar, bio.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid);

      // Private: bottles at home and wishlist.
      match /cellar/{id} { allow read, write: if isMe(uid); }
      match /wishlist/{id} { allow read, write: if isMe(uid); }
    }

    // One doc per username, to keep usernames unique.
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Doc id is the two uids sorted and joined with "_".
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && id == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      // Only the person who received the request can accept it.
      allow update: if signedIn()
        && request.auth.uid in resource.data.users
        && resource.data.requestedBy != request.auth.uid
        && request.resource.data.status == 'accepted'
        && changedOnly(['status', 'acceptedAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // Shared wine catalogue. Anyone signed in can add a wine; anyone can add
    // photos, stores and ratings; only the creator can edit the details.
    match /wines/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (
        changedOnly(['photos', 'storeIds', 'ratingSum', 'ratingCount'])
        || (resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == request.auth.uid)
      );
    }

    // Producers: anyone signed in can add one; only the person who added it can change it.
    match /producers/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /stores/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // A check-in is readable by its owner and by the uids in visibleTo
    // (owner + their friends, or only the owner when private).
    match /checkins/{id} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || request.auth.uid in resource.data.visibleTo);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.auth.uid in request.resource.data.visibleTo;
      allow update: if signedIn() && (
        (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid)
        || (request.auth.uid in resource.data.visibleTo && changedOnly(['cheers', 'commentCount']))
      );
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /comments/{commentId} {
        function canSee() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/checkins/$(id)).data.visibleTo;
        }
        allow read: if canSee();
        allow create: if canSee() && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
